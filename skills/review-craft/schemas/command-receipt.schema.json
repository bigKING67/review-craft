{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/command-receipt.schema.json",
  "title": "Evidence command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "argv", "cwd", "startedAt", "durationMs", "exitCode", "timedOut", "stdoutArtifact", "stderrArtifact", "beforeStatusSha256", "afterStatusSha256", "repositoryMutationDetected"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "name": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cwd": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "exitCode": {"type": "integer"},
    "timedOut": {"type": "boolean"},
    "stdoutArtifact": {"type": "string", "minLength": 1},
    "stderrArtifact": {"type": "string", "minLength": 1},
    "beforeStatusSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "afterStatusSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositoryMutationDetected": {"type": "boolean"}
  }
}
