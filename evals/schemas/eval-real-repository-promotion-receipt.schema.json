{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-promotion-receipt.schema.json",
  "title": "Purpose-bound real-repository campaign promotion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "campaignPurpose",
    "promotionPolicyVersion",
    "promotionPolicyContentSha256",
    "reviewCraftSourceContentSha256",
    "planContentSha256",
    "campaignContentSha256",
    "budgetLedgerContentSha256",
    "adjudicationContentSha256",
    "oracleAssessmentContentSha256",
    "stabilityReportContentSha256",
    "samples",
    "checks",
    "comparisons",
    "limitations",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-promotion-receipt.v1"},
    "status": {"enum": ["ELIGIBLE", "BLOCKED"]},
    "campaignPurpose": {
      "enum": ["CANARY", "CORE_ITERATION", "RISK_ITERATION", "CANDIDATE", "GOLDEN"]
    },
    "promotionPolicyVersion": {
      "const": "review-craft.eval-campaign-promotion-policy.v1"
    },
    "promotionPolicyContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewCraftSourceContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budgetLedgerContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudicationContentSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracleAssessmentContentSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "stabilityReportContentSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "observed", "completed"],
      "properties": {
        "planned": {"type": "integer", "minimum": 1},
        "observed": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelConfigurationId",
          "treatment",
          "baselineTreatment",
          "correctRateDelta",
          "incorrectRateDelta",
          "exactOracleRecallDelta",
          "tokenCostRatio",
          "wallTimeRatio",
          "passed"
        ],
        "properties": {
          "modelConfigurationId": {"type": "string", "minLength": 1},
          "treatment": {"enum": ["RISK_LENS_REVIEW", "REVIEW_CRAFT_EVIDENCE_LOOP"]},
          "baselineTreatment": {
            "enum": ["ORDINARY_PROMPT", "REVIEW_CRAFT_EVIDENCE_LOOP"]
          },
          "correctRateDelta": {"type": ["number", "null"]},
          "incorrectRateDelta": {"type": ["number", "null"]},
          "exactOracleRecallDelta": {"type": ["number", "null"]},
          "tokenCostRatio": {"type": ["number", "null"], "minimum": 0},
          "wallTimeRatio": {"type": ["number", "null"], "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
