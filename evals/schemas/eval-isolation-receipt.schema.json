{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-isolation-receipt.schema.json",
  "title": "Per-invocation Codex home isolation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "availability", "policy", "preRun", "postStart", "postExit", "comparison", "unavailableReason"],
  "properties": {
    "schema": {"const": "review-craft.eval-isolation-receipt.v1"},
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homeMatchesCodexHome", "ignoreUserConfig", "ignoreRules", "allowCodexHomeExtensions"],
      "properties": {
        "homeMatchesCodexHome": {"const": true},
        "ignoreUserConfig": {"const": true},
        "ignoreRules": {"const": true},
        "allowCodexHomeExtensions": {"type": "boolean"}
      }
    },
    "preRun": {"$ref": "#/$defs/surface"},
    "postStart": {"anyOf": [{"$ref": "#/$defs/surface"}, {"type": "null"}]},
    "postExit": {"anyOf": [{"$ref": "#/$defs/surface"}, {"type": "null"}]},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postStartSystemState", "postStartUserExtensionState", "postExitSystemState", "postExitUserExtensionState", "overall"],
      "properties": {
        "postStartSystemState": {"$ref": "#/$defs/comparison"},
        "postStartUserExtensionState": {"$ref": "#/$defs/comparison"},
        "postExitSystemState": {"$ref": "#/$defs/comparison"},
        "postExitUserExtensionState": {"$ref": "#/$defs/comparison"},
        "overall": {"enum": ["MATCHED", "SYSTEM_STATE_DRIFT", "USER_EXTENSION_DRIFT", "CAPTURE_UNAVAILABLE"]}
      }
    },
    "unavailableReason": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"availability": {"const": "AVAILABLE"}},
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "postStart": {"$ref": "#/$defs/surface"},
          "postExit": {"$ref": "#/$defs/surface"},
          "comparison": {
            "properties": {
              "postStartSystemState": {"enum": ["MATCHED", "DRIFTED"]},
              "postStartUserExtensionState": {"enum": ["MATCHED", "DRIFTED"]},
              "postExitSystemState": {"enum": ["MATCHED", "DRIFTED"]},
              "postExitUserExtensionState": {"enum": ["MATCHED", "DRIFTED"]},
              "overall": {"enum": ["MATCHED", "SYSTEM_STATE_DRIFT", "USER_EXTENSION_DRIFT"]}
            }
          },
          "unavailableReason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"availability": {"const": "UNAVAILABLE"}},
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {"overall": {"const": "CAPTURE_UNAVAILABLE"}}
          },
          "unavailableReason": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "comparison": {
            "properties": {"overall": {"const": "MATCHED"}},
            "required": ["overall"]
          }
        },
        "required": ["comparison"]
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "postStartSystemState": {"const": "MATCHED"},
              "postStartUserExtensionState": {"const": "MATCHED"},
              "postExitSystemState": {"const": "MATCHED"},
              "postExitUserExtensionState": {"const": "MATCHED"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "comparison": {"enum": ["MATCHED", "DRIFTED", "NOT_CAPTURED"]},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "systemFileCount", "systemTreeSha256", "userExtensionFileCount", "userExtensionTreeSha256"],
      "properties": {
        "capturedAt": {"type": "string", "format": "date-time"},
        "systemFileCount": {"type": "integer", "minimum": 0},
        "systemTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "userExtensionFileCount": {"type": "integer", "minimum": 0},
        "userExtensionTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
