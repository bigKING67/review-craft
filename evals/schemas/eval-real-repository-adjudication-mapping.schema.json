{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-adjudication-mapping.schema.json",
  "title": "Coordinator-only mapping for blinded adjudication packets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignContentSha256", "packets", "subjects", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-adjudication-mapping.v1"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adjudicatorId", "packetContentSha256"],
        "properties": {
          "adjudicatorId": {"type": "string", "minLength": 1},
          "packetContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adjudicatorId", "itemId", "sampleId", "subjectType", "subjectKey"],
        "properties": {
          "adjudicatorId": {"type": "string", "minLength": 1},
          "itemId": {"type": "string", "pattern": "^item-[0-9a-f]{20}$"},
          "sampleId": {"type": "string", "minLength": 1},
          "subjectType": {"enum": ["PROBE_RESPONSE", "ADDITIONAL_FINDING"]},
          "subjectKey": {"type": "string", "minLength": 1}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
