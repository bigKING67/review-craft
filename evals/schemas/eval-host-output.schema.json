{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-host-output.schema.json",
  "title": "Normalized host output for one Review Craft evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "findingDetected",
    "decisions",
    "locations",
    "evidence",
    "confidence",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "review-craft.eval-host-output.v1"
    },
    "findingDetected": {
      "type": "boolean"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KEEP",
          "CLEAN_UP",
          "MERGE",
          "REPLACE",
          "REWRITE",
          "DELETE",
          "DEFER",
          "MEASURE",
          "DOCUMENT"
        ]
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "locations"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/location"
            }
          }
        }
      }
    },
    "confidence": {
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lineStart", "lineEnd"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
