{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-campaign-plan.schema.json",
  "title": "Real-repository benchmark campaign execution plan",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "modelConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "reasoning",
        "adapterName",
        "adapterVersion",
        "hostVersion",
        "evidenceKind",
        "providerName",
        "isolationSha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "adapterName": {"type": "string", "minLength": 1},
        "adapterVersion": {"type": "string", "minLength": 1},
        "hostVersion": {"type": "string", "minLength": 1},
        "evidenceKind": {"const": "REAL_HOST"},
        "providerName": {"type": "string", "minLength": 1},
        "isolationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "isolationReceiptProtocol": {"const": "review-craft.eval-isolation-receipt.v1"}
      }
    }
  },
  "required": [
    "schema",
    "campaignId",
    "suiteSha256",
    "blindSuiteSha256",
    "materializationContentSha256",
    "adapterConfigSha256",
    "modelConfigurations",
    "selection",
    "budgets",
    "samples",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-campaign-plan.v1"},
    "campaignId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "suiteSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blindSuiteSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materializationContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapterConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modelConfigurations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/modelConfiguration"}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "treatments",
        "modelConfigurations",
        "repetitions",
        "fullMatrix"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "treatments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["ORDINARY_PROMPT", "RISK_LENS_REVIEW", "REVIEW_CRAFT_EVIDENCE_LOOP"]
          }
        },
        "modelConfigurations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "repetitions": {"type": "integer", "minimum": 1},
        "fullMatrix": {"type": "boolean"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleTimeoutSeconds",
        "softWallTimeSeconds",
        "hardWallTimeSeconds",
        "hardReportedTokenCeiling",
        "maxConsecutiveInfrastructureFailures"
      ],
      "properties": {
        "sampleTimeoutSeconds": {"type": "integer", "minimum": 1},
        "softWallTimeSeconds": {"type": "integer", "minimum": 1},
        "hardWallTimeSeconds": {"type": "integer", "minimum": 1},
        "hardReportedTokenCeiling": {"type": "integer", "minimum": 1},
        "hardReportedInputTokenCeilingPerSample": {"type": "integer", "minimum": 1},
        "hardReportedTokenCeilingPerSample": {"type": "integer", "minimum": 1},
        "hardReportedInputTokenCeilingPerRepositoryShard": {"type": "integer", "minimum": 1},
        "hardReportedTokenCeilingPerRepositoryShard": {"type": "integer", "minimum": 1},
        "maxConsecutiveInfrastructureFailures": {"type": "integer", "minimum": 1},
        "maxUnknownUsageSamples": {"type": "integer", "minimum": 1},
        "maxTimedOutSamplesPerModelProfile": {"type": "integer", "minimum": 1},
        "maxArtifactInvalidSamples": {"type": "integer", "minimum": 1},
        "inactivityWarningSeconds": {"type": "integer", "minimum": 1},
        "inactivityDiagnosticSeconds": {"type": "integer", "minimum": 1},
        "maxRecoveredInactivitySamplesPerModelProfile": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "sampleId",
          "repositoryId",
          "treatment",
          "modelConfigurationId",
          "repetition",
          "shardId",
          "timeoutSeconds"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "sampleId": {"type": "string", "minLength": 1},
          "repositoryId": {"type": "string", "minLength": 1},
          "treatment": {
            "enum": ["ORDINARY_PROMPT", "RISK_LENS_REVIEW", "REVIEW_CRAFT_EVIDENCE_LOOP"]
          },
          "modelConfigurationId": {"type": "string", "minLength": 1},
          "repetition": {"type": "integer", "minimum": 1},
          "shardId": {"type": "string", "minLength": 1},
          "timeoutSeconds": {"type": "integer", "minimum": 1},
          "promptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
