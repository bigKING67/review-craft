{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-ablation-adjudication-result.schema.json",
  "title": "Canonical unblinded four-arm adjudication result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ablation", "adjudicator", "bundleContentSha256", "inputContentSha256", "treatments", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-ablation-adjudication-result.v1"},
    "ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adjudicator": {"$ref": "eval-ablation-adjudication.schema.json#/$defs/adjudicator"},
    "bundleContentSha256": {"$ref": "#/$defs/sha256"},
    "inputContentSha256": {"$ref": "#/$defs/sha256"},
    "treatments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["treatment", "runId", "runContentSha256", "cases", "metrics"],
        "properties": {
          "treatment": {"type": "string", "minLength": 1},
          "runId": {"type": "string", "minLength": 1},
          "runContentSha256": {"$ref": "#/$defs/sha256"},
          "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "metrics": {"$ref": "#/$defs/metrics"}
        }
      }
    },
    "contentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullablePercentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCases", "resolvedCases", "unresolvedCases", "positiveCases", "negativeCases",
        "seededIssueMatches", "missedSeededIssues", "validFindings", "falsePositiveFindings",
        "contaminatedNegativeCases", "semanticSeededRecallPercent", "semanticFindingPrecisionPercent",
        "semanticFalsePositiveRatePercent", "semanticDecisionAccuracyPercent",
        "semanticEvidenceAdequacyPercent", "semanticFalsificationAdequacyPercent",
        "semanticDecisiveExternalFeedbackPercent", "semanticEvidenceValidation"
      ],
      "properties": {
        "totalCases": {"type": "integer", "minimum": 1},
        "resolvedCases": {"type": "integer", "minimum": 0},
        "unresolvedCases": {"type": "integer", "minimum": 0},
        "positiveCases": {"type": "integer", "minimum": 0},
        "negativeCases": {"type": "integer", "minimum": 0},
        "seededIssueMatches": {"type": "integer", "minimum": 0},
        "missedSeededIssues": {"type": "integer", "minimum": 0},
        "validFindings": {"type": "integer", "minimum": 0},
        "falsePositiveFindings": {"type": "integer", "minimum": 0},
        "contaminatedNegativeCases": {"type": "integer", "minimum": 0},
        "semanticSeededRecallPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFindingPrecisionPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFalsePositiveRatePercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticDecisionAccuracyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticEvidenceAdequacyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFalsificationAdequacyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticDecisiveExternalFeedbackPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticEvidenceValidation": {"enum": ["ADJUDICATED", "PARTIAL"]}
      }
    }
  }
}
