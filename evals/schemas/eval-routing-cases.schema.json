{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-routing-cases.schema.json",
  "title": "Review Craft routing decision cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "review-craft.eval-routing-cases.v1"},
    "cases": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "route": {
      "enum": [
        "REVIEW_CRAFT",
        "NATIVE_REVIEW",
        "DESIGN_CRAFT",
        "CODEX_SECURITY",
        "DIRECT_TASK"
      ]
    },
    "workflow": {
      "enum": ["BOUNDED", "REVIEW", "DIFF", "FOCUS", "REMEDIATION", "DELIVERY", "NONE"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "prompt",
        "invocation",
        "expectedRoute",
        "expectedWorkflow",
        "allowedRoutes",
        "forbiddenRoutes",
        "highCostNegative",
        "reason"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "language": {"enum": ["zh-CN", "en"]},
        "prompt": {"type": "string", "minLength": 3},
        "invocation": {"enum": ["implicit", "explicit"]},
        "expectedRoute": {"$ref": "#/$defs/route"},
        "expectedWorkflow": {"$ref": "#/$defs/workflow"},
        "allowedRoutes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/route"}
        },
        "forbiddenRoutes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/route"}
        },
        "highCostNegative": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 3}
      }
    }
  }
}
