{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-campaign.schema.json",
  "title": "Real-repository benchmark campaign",
  "type": "object",
  "$defs": {
    "modelConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "reasoning",
        "adapterName",
        "adapterVersion",
        "hostVersion",
        "evidenceKind",
        "providerName",
        "isolationSha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "adapterName": {"type": "string", "minLength": 1},
        "adapterVersion": {"type": "string", "minLength": 1},
        "hostVersion": {"type": "string", "minLength": 1},
        "evidenceKind": {"const": "REAL_HOST"},
        "providerName": {"type": "string", "minLength": 1},
        "isolationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": false,
  "required": ["schema", "campaignId", "status", "suiteSha256", "blindSuiteSha256", "samples", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-campaign.v1"},
    "campaignId": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETED", "PARTIAL", "FAILED"]},
    "suiteSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blindSuiteSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "repositoryId",
          "treatment",
          "modelConfiguration",
          "repetition",
          "status",
          "durationSeconds",
          "usage",
          "sourceMutationDetected",
          "output",
          "failureReason",
          "artifacts"
        ],
        "properties": {
          "sampleId": {"type": "string", "minLength": 1},
          "repositoryId": {"type": "string", "minLength": 1},
          "treatment": {"enum": ["ORDINARY_PROMPT", "RISK_LENS_REVIEW", "REVIEW_CRAFT_EVIDENCE_LOOP"]},
          "modelConfiguration": {"$ref": "#/$defs/modelConfiguration"},
          "repetition": {"type": "integer", "minimum": 1},
          "status": {"enum": ["COMPLETED", "FAILED", "TIMED_OUT"]},
          "durationSeconds": {"type": "number", "minimum": 0},
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputTokens", "outputTokens", "totalTokens", "toolCalls"],
            "properties": {
              "inputTokens": {"type": ["integer", "null"], "minimum": 0},
              "outputTokens": {"type": ["integer", "null"], "minimum": 0},
              "totalTokens": {"type": ["integer", "null"], "minimum": 0},
              "toolCalls": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "sourceMutationDetected": {"type": "boolean"},
          "lifecycle": {"$ref": "eval-progress.schema.json"},
          "output": {"type": ["object", "null"]},
          "failureReason": {"type": ["string", "null"]},
          "failureClass": {
            "type": ["string", "null"],
            "enum": [
              null,
              "AUTHENTICATION",
              "PROVIDER_CONNECTIVITY",
              "ADAPTER_CONTRACT",
              "MODEL_UNAVAILABLE",
              "TIMEOUT",
              "REVIEW_FAILURE",
              "SOURCE_MUTATION",
              "ARTIFACT_INVALID",
              "CREDENTIAL_EXPOSURE"
            ]
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["promptSha256", "stdoutSha256", "stderrSha256", "usageSha256", "outputSha256"],
            "properties": {
              "promptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "stdoutSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "stderrSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "usageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "outputSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "toolTraceSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "progressSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
