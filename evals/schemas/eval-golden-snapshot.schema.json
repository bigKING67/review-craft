{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-golden-snapshot.schema.json",
  "title": "Sanitized immutable Golden evaluation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "suite",
    "skill",
    "host",
    "comparison",
    "results",
    "semantic",
    "contentSha256"
  ],
  "properties": {
    "schema": {
      "const": "review-craft.eval-golden-snapshot.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "treeSha256",
        "runnerSha256",
        "dirty",
        "stableThroughoutRun"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "const": false
        },
        "stableThroughoutRun": {
          "const": true
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "selectedCaseIds",
        "fullSuite"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selectedCaseIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fullSuite": {
          "const": true
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "treeSha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "comparativeEligible"
      ],
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "comparativeEligible": {
          "const": true
        }
      }
    },
    "results": {
      "$ref": "#/$defs/treatmentPair"
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator",
        "comparativeEligible",
        "reviewCraft",
        "baseline",
        "metricDeltaPercentagePoints"
      ],
      "properties": {
        "adjudicator": {
          "$ref": "#/$defs/adjudicator"
        },
        "comparativeEligible": {
          "const": true
        },
        "reviewCraft": {
          "$ref": "#/$defs/semanticResult"
        },
        "baseline": {
          "$ref": "#/$defs/semanticResult"
        },
        "metricDeltaPercentagePoints": {
          "$ref": "#/$defs/semanticDeltas"
        }
      }
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "nullablePercentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "percentageDelta": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -100,
      "maximum": 100
    },
    "structuralMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCases",
        "completedCases",
        "failedCases",
        "unavailableCases",
        "totalDurationMs",
        "executionCoveragePercent",
        "candidateRecallPercent",
        "findingPrecisionPercent",
        "falsePositiveRatePercent",
        "locationAccuracyPercent",
        "evidencePresencePercent",
        "decisionAccuracyPercent",
        "rewriteRestraintPercent",
        "semanticEvidenceValidation"
      ],
      "properties": {
        "totalCases": {"type": "integer", "minimum": 1},
        "completedCases": {"type": "integer", "minimum": 0},
        "failedCases": {"type": "integer", "minimum": 0},
        "unavailableCases": {"type": "integer", "minimum": 0},
        "totalDurationMs": {"type": "integer", "minimum": 0},
        "executionCoveragePercent": {"$ref": "#/$defs/percentage"},
        "candidateRecallPercent": {"$ref": "#/$defs/nullablePercentage"},
        "findingPrecisionPercent": {"$ref": "#/$defs/nullablePercentage"},
        "falsePositiveRatePercent": {"$ref": "#/$defs/nullablePercentage"},
        "locationAccuracyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "evidencePresencePercent": {"$ref": "#/$defs/nullablePercentage"},
        "decisionAccuracyPercent": {"$ref": "#/$defs/percentage"},
        "rewriteRestraintPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticEvidenceValidation": {"const": "NOT_AUTOMATED"}
      }
    },
    "semanticMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCases",
        "resolvedCases",
        "unresolvedCases",
        "positiveCases",
        "negativeCases",
        "seededIssueMatches",
        "missedSeededIssues",
        "validFindings",
        "falsePositiveFindings",
        "contaminatedNegativeCases",
        "semanticSeededRecallPercent",
        "semanticFindingPrecisionPercent",
        "semanticFalsePositiveRatePercent",
        "semanticDecisionAccuracyPercent",
        "semanticEvidenceValidation"
      ],
      "properties": {
        "totalCases": {"type": "integer", "minimum": 1},
        "resolvedCases": {"type": "integer", "minimum": 0},
        "unresolvedCases": {"type": "integer", "minimum": 0},
        "positiveCases": {"type": "integer", "minimum": 0},
        "negativeCases": {"type": "integer", "minimum": 0},
        "seededIssueMatches": {"type": "integer", "minimum": 0},
        "missedSeededIssues": {"type": "integer", "minimum": 0},
        "validFindings": {"type": "integer", "minimum": 0},
        "falsePositiveFindings": {"type": "integer", "minimum": 0},
        "contaminatedNegativeCases": {"type": "integer", "minimum": 0},
        "semanticSeededRecallPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFindingPrecisionPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFalsePositiveRatePercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticDecisionAccuracyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticEvidenceValidation": {"const": "ADJUDICATED"}
      }
    },
    "semanticDeltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticDecisionAccuracyPercent",
        "semanticFalsePositiveRatePercent",
        "semanticFindingPrecisionPercent",
        "semanticSeededRecallPercent"
      ],
      "properties": {
        "semanticDecisionAccuracyPercent": {"$ref": "#/$defs/percentageDelta"},
        "semanticFalsePositiveRatePercent": {"$ref": "#/$defs/percentageDelta"},
        "semanticFindingPrecisionPercent": {"$ref": "#/$defs/percentageDelta"},
        "semanticSeededRecallPercent": {"$ref": "#/$defs/percentageDelta"}
      }
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol"
      ],
      "properties": {
        "kind": {
          "enum": [
            "HUMAN",
            "AGENT_ASSISTED"
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowCodexHomeExtensions",
        "codexHomeExtensionFileCount",
        "codexHomeExtensionTreeSha256",
        "codexHomeSystemFileCount",
        "codexHomeSystemTreeSha256",
        "ignoreRules",
        "ignoreUserConfig"
      ],
      "properties": {
        "allowCodexHomeExtensions": {
          "type": "boolean"
        },
        "codexHomeExtensionFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "codexHomeExtensionTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "codexHomeSystemFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "codexHomeSystemTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "ignoreRules": {
          "const": true
        },
        "ignoreUserConfig": {
          "const": true
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model",
        "reasoning",
        "adapterVersion",
        "evidenceKind",
        "provider",
        "isolation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "evidenceKind": {
          "const": "REAL_HOST"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "wireApi",
            "requiresOpenAIAuth",
            "supportsWebsockets"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "wireApi": {
              "enum": [
                "responses",
                "chat"
              ]
            },
            "requiresOpenAIAuth": {
              "type": "boolean"
            },
            "supportsWebsockets": {
              "type": "boolean"
            }
          }
        },
        "isolation": {
          "$ref": "#/$defs/isolation"
        }
      }
    },
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "contentSha256",
        "treatment",
        "goldenEligible",
        "metrics"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "treatment": {
          "enum": [
            "REVIEW_CRAFT",
            "ORDINARY_PROMPT"
          ]
        },
        "goldenEligible": {
          "const": true
        },
        "metrics": {
          "$ref": "#/$defs/structuralMetrics"
        }
      }
    },
    "treatmentPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewCraft",
        "baseline"
      ],
      "properties": {
        "reviewCraft": {
          "$ref": "#/$defs/runResult"
        },
        "baseline": {
          "$ref": "#/$defs/runResult"
        }
      }
    },
    "semanticResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "metrics"
      ],
      "properties": {
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "metrics": {
          "$ref": "#/$defs/semanticMetrics"
        }
      }
    }
  }
}
