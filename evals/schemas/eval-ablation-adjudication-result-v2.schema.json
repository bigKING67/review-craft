{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-ablation-adjudication-result-v2.schema.json",
  "title": "Canonical unblinded three-arm adjudication result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ablation", "adjudicator", "bundleContentSha256", "inputContentSha256", "treatments", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-ablation-adjudication-result.v2"},
    "ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adjudicator": {"$ref": "eval-ablation-adjudication-v2.schema.json#/$defs/adjudicator"},
    "bundleContentSha256": {"$ref": "#/$defs/sha256"},
    "inputContentSha256": {"$ref": "#/$defs/sha256"},
    "treatments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["treatment", "runId", "runContentSha256", "cases", "metrics"],
        "properties": {
          "treatment": {
            "enum": [
              "ORDINARY_PROMPT",
              "RISK_LENS_REVIEW",
              "REVIEW_CRAFT_EVIDENCE_LOOP"
            ]
          },
          "runId": {"type": "string", "minLength": 1},
          "runContentSha256": {"$ref": "#/$defs/sha256"},
          "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "metrics": {"$ref": "eval-ablation-adjudication-result.schema.json#/$defs/metrics"}
        }
      }
    },
    "contentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
