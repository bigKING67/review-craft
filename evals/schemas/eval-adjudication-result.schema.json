{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-adjudication-result.schema.json",
  "title": "Canonical semantic adjudication result for one evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run",
    "adjudicator",
    "inputContentSha256",
    "cases",
    "metrics",
    "contentSha256"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-adjudication-result.v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256", "suiteSha256", "treatment"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rce-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "suiteSha256": {
          "$ref": "#/$defs/sha256"
        },
        "treatment": {
          "type": "string",
          "enum": ["REVIEW_CRAFT", "ORDINARY_PROMPT", "CODEX_NATIVE_REVIEW"]
        }
      }
    },
    "adjudicator": {
      "$ref": "#/$defs/adjudicator"
    },
    "inputContentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCases",
        "resolvedCases",
        "unresolvedCases",
        "positiveCases",
        "negativeCases",
        "seededIssueMatches",
        "missedSeededIssues",
        "validFindings",
        "falsePositiveFindings",
        "contaminatedNegativeCases",
        "semanticSeededRecallPercent",
        "semanticFindingPrecisionPercent",
        "semanticFalsePositiveRatePercent",
        "semanticDecisionAccuracyPercent",
        "semanticEvidenceValidation"
      ],
      "properties": {
        "totalCases": {"type": "integer", "minimum": 1},
        "resolvedCases": {"type": "integer", "minimum": 0},
        "unresolvedCases": {"type": "integer", "minimum": 0},
        "positiveCases": {"type": "integer", "minimum": 0},
        "negativeCases": {"type": "integer", "minimum": 0},
        "seededIssueMatches": {"type": "integer", "minimum": 0},
        "missedSeededIssues": {"type": "integer", "minimum": 0},
        "validFindings": {"type": "integer", "minimum": 0},
        "falsePositiveFindings": {"type": "integer", "minimum": 0},
        "contaminatedNegativeCases": {"type": "integer", "minimum": 0},
        "semanticSeededRecallPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFindingPrecisionPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticFalsePositiveRatePercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticDecisionAccuracyPercent": {"$ref": "#/$defs/nullablePercentage"},
        "semanticEvidenceValidation": {
          "type": "string",
          "enum": ["ADJUDICATED", "PARTIAL"]
        }
      }
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullablePercentage": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["HUMAN", "AGENT_ASSISTED"]
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "normalizedOutputSha256",
        "outcome",
        "decisionDisposition",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "normalizedOutputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "SEEDED_ISSUE_MATCH",
            "OTHER_VALID_FINDING",
            "FALSE_POSITIVE",
            "MISS",
            "NO_FINDING_CORRECT",
            "UNRESOLVED"
          ]
        },
        "decisionDisposition": {
          "type": "string",
          "enum": ["APPROPRIATE", "INAPPROPRIATE", "UNRESOLVED"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
