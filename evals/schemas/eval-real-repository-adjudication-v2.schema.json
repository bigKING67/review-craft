{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-adjudication-v2.schema.json",
  "title": "Independent adjudication for all completed campaign subjects",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignContentSha256", "mappingContentSha256", "adjudicators", "labels", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-adjudication.v2"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mappingContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudicators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "independent", "packetContentSha256", "submissionContentSha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["HUMAN", "AGENT_ASSISTED"]},
          "independent": {"const": true},
          "packetContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "submissionContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adjudicatorId", "itemId", "sampleId", "subjectType", "subjectKey", "label", "rationale"],
        "properties": {
          "adjudicatorId": {"type": "string", "minLength": 1},
          "itemId": {"type": "string", "pattern": "^item-[0-9a-f]{20}$"},
          "sampleId": {"type": "string", "minLength": 1},
          "subjectType": {"enum": ["PROBE_RESPONSE", "ADDITIONAL_FINDING"]},
          "subjectKey": {"type": "string", "minLength": 1},
          "label": {"enum": ["CORRECT", "INCORRECT", "UNRESOLVED"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
