{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-oracle-assessment.schema.json",
  "title": "Post-adjudication real-repository oracle assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "sourceSuiteSha256",
    "campaignContentSha256",
    "adjudicationContentSha256",
    "rubricVersion",
    "verifier",
    "assessments",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-oracle-assessment.v1"},
    "status": {"enum": ["DRAFT", "FINAL"]},
    "sourceSuiteSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudicationContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubricVersion": {"const": "review-craft.real-repository-oracle-match-rubric.v1"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["HUMAN", "AGENT_ASSISTED"]}
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "repositoryId",
          "probeId",
          "subjectContentSha256",
          "oracleContentSha256",
          "responseValidity",
          "observedRootCauseKey",
          "classification",
          "rationale"
        ],
        "properties": {
          "sampleId": {"type": "string", "minLength": 1},
          "repositoryId": {"type": "string", "minLength": 1},
          "probeId": {"type": "string", "minLength": 1},
          "subjectContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "oracleContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "responseValidity": {"enum": ["CORRECT", "INCORRECT", "UNRESOLVED"]},
          "observedRootCauseKey": {"type": ["string", "null"], "minLength": 1},
          "classification": {
            "type": ["string", "null"],
            "enum": [
              "EXACT_ORACLE_MATCH",
              "ALTERNATIVE_VALID_FINDING",
              "MISSED",
              "UNRESOLVED",
              null
            ]
          },
          "rationale": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "FINAL"}}},
      "then": {
        "properties": {
          "assessments": {
            "items": {
              "properties": {
                "classification": {
                  "enum": [
                    "EXACT_ORACLE_MATCH",
                    "ALTERNATIVE_VALID_FINDING",
                    "MISSED",
                    "UNRESOLVED"
                  ]
                },
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  ]
}
