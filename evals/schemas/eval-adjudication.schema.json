{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-adjudication.schema.json",
  "title": "Content-bound semantic adjudication input for one evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "runContentSha256", "adjudicator", "cases"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-adjudication.v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^rce-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"
    },
    "runContentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "adjudicator": {
      "$ref": "#/$defs/adjudicator"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["HUMAN", "AGENT_ASSISTED"]
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "normalizedOutputSha256",
        "outcome",
        "decisionDisposition",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "normalizedOutputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "SEEDED_ISSUE_MATCH",
            "OTHER_VALID_FINDING",
            "FALSE_POSITIVE",
            "MISS",
            "NO_FINDING_CORRECT",
            "UNRESOLVED"
          ]
        },
        "decisionDisposition": {
          "type": "string",
          "enum": ["APPROPRIATE", "INAPPROPRIATE", "UNRESOLVED"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
