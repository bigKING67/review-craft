{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-remediation-run.schema.json",
  "title": "Remediation safety evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "status",
    "startedAt",
    "completedAt",
    "roundLimit",
    "source",
    "suite",
    "skill",
    "adapter",
    "schedule",
    "cases",
    "metrics",
    "artifacts",
    "contentSha256"
  ],
  "properties": {
    "schema": {"type": "string", "const": "review-craft.eval-remediation-run.v1"},
    "runId": {"type": "string", "pattern": "^rcrs-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"},
    "status": {"type": "string", "enum": ["COMPLETED", "PARTIAL", "FAILED", "UNAVAILABLE"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "roundLimit": {"type": "integer", "minimum": 1, "maximum": 5},
    "source": {"type": "object"},
    "suite": {"type": "object"},
    "skill": {"type": "object"},
    "adapter": {"type": "object"},
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "order"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "order": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string"}
          }
        }
      }
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "class", "pairId", "baselineClaims", "arms"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "enum": ["positive", "negative"]},
        "pairId": {"type": "string", "minLength": 1},
        "baselineClaims": {"type": "array"},
        "arms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/armResult"}
        }
      }
    },
    "armResult": {
      "type": "object",
      "required": [
        "arm",
        "status",
        "stopReason",
        "rounds",
        "finalClaims",
        "everRegressed",
        "scopeViolation",
        "sandboxBreach",
        "sourceMutationRounds",
        "cumulativeChangedPaths",
        "cumulativeLineChurn",
        "reviewInvocations",
        "repairInvocations"
      ],
      "properties": {
        "arm": {"type": "string"},
        "rounds": {"type": "array"},
        "initialReviewDecision": {"$ref": "#/$defs/nullableDecision"},
        "initialDecisionDisposition": {
          "type": ["string", "null"],
          "enum": ["ALIGNED", "UNEXPECTED", "PROHIBITED", null]
        }
      },
      "dependentRequired": {
        "initialReviewDecision": ["initialDecisionDisposition"],
        "initialDecisionDisposition": ["initialReviewDecision"]
      }
    },
    "nullableDecision": {
      "type": ["string", "null"],
      "enum": [
        "KEEP",
        "CLEAN_UP",
        "MERGE",
        "REPLACE",
        "REWRITE",
        "DELETE",
        "DEFER",
        "MEASURE",
        "DOCUMENT",
        null
      ]
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "percent"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "armMetrics": {
      "type": "object",
      "properties": {
        "initialDecisionAlignmentRate": {"$ref": "#/$defs/rate"},
        "initialUnexpectedDecisionRate": {"$ref": "#/$defs/rate"},
        "initialProhibitedDecisionRate": {"$ref": "#/$defs/rate"}
      },
      "dependentRequired": {
        "initialDecisionAlignmentRate": [
          "initialUnexpectedDecisionRate",
          "initialProhibitedDecisionRate"
        ],
        "initialUnexpectedDecisionRate": [
          "initialDecisionAlignmentRate",
          "initialProhibitedDecisionRate"
        ],
        "initialProhibitedDecisionRate": [
          "initialDecisionAlignmentRate",
          "initialUnexpectedDecisionRate"
        ]
      }
    },
    "percentagePointDeltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanCaseMutationRate",
        "claimRegressionRate",
        "defectClaimResolutionRate",
        "repairSuccessRate"
      ],
      "properties": {
        "cleanCaseMutationRate": {"type": ["number", "null"]},
        "claimRegressionRate": {"type": ["number", "null"]},
        "defectClaimResolutionRate": {"type": ["number", "null"]},
        "repairSuccessRate": {"type": ["number", "null"]},
        "initialDecisionAlignmentRate": {"type": ["number", "null"]},
        "initialUnexpectedDecisionRate": {"type": ["number", "null"]},
        "initialProhibitedDecisionRate": {"type": ["number", "null"]}
      },
      "dependentRequired": {
        "initialDecisionAlignmentRate": [
          "initialUnexpectedDecisionRate",
          "initialProhibitedDecisionRate"
        ],
        "initialUnexpectedDecisionRate": [
          "initialDecisionAlignmentRate",
          "initialProhibitedDecisionRate"
        ],
        "initialProhibitedDecisionRate": [
          "initialDecisionAlignmentRate",
          "initialUnexpectedDecisionRate"
        ]
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "from", "to", "percentagePointDeltas"],
      "properties": {
        "label": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "percentagePointDeltas": {"$ref": "#/$defs/percentagePointDeltas"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "comparisons"],
      "properties": {
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ORDINARY_NAIVE_LOOP",
            "REVIEW_CRAFT_UNGATED_LOOP",
            "REVIEW_CRAFT_EVIDENCE_GATED_LOOP"
          ],
          "properties": {
            "ORDINARY_NAIVE_LOOP": {"$ref": "#/$defs/armMetrics"},
            "REVIEW_CRAFT_UNGATED_LOOP": {"$ref": "#/$defs/armMetrics"},
            "REVIEW_CRAFT_EVIDENCE_GATED_LOOP": {"$ref": "#/$defs/armMetrics"}
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/comparison"}
        }
      }
    }
  }
}
