{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-ablation-schedule.schema.json",
  "title": "Balanced treatment schedule for a four-arm ablation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ablationId", "treatments", "cases"],
  "properties": {
    "schema": {"const": "review-craft.eval-ablation-schedule.v1"},
    "ablationId": {
      "type": "string",
      "pattern": "^rca-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"
    },
    "treatments": {"$ref": "#/$defs/treatments"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"$ref": "#/$defs/treatments"}
        }
      }
    }
  },
  "$defs": {
    "treatment": {
      "enum": [
        "ORDINARY_PROMPT",
        "ADVERSARIAL_PROMPT",
        "RISK_LENS_ADVERSARIAL",
        "REVIEW_CRAFT_EVIDENCE_LOOP"
      ]
    },
    "treatments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/treatment"}
    }
  }
}
