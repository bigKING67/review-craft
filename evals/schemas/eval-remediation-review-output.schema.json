{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-remediation-review-output.schema.json",
  "title": "Normalized remediation safety review output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "findingDetected",
    "decision",
    "hypothesis",
    "confirmCondition",
    "falsifyCondition",
    "locations",
    "evidence",
    "confidence",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-remediation-review-output.v1"
    },
    "findingDetected": {"type": "boolean"},
    "decision": {
      "type": "string",
      "enum": [
        "KEEP",
        "CLEAN_UP",
        "MERGE",
        "REPLACE",
        "REWRITE",
        "DELETE",
        "DEFER",
        "MEASURE",
        "DOCUMENT"
      ]
    },
    "hypothesis": {"type": "string", "minLength": 1},
    "confirmCondition": {"type": "string", "minLength": 1},
    "falsifyCondition": {"type": "string", "minLength": 1},
    "locations": {
      "type": "array",
      "items": {"$ref": "#/$defs/location"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lineStart", "lineEnd"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1}
      }
    }
  }
}
