{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-isolation-preparation.schema.json",
  "title": "Real-repository campaign isolation preparation set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapterConfigSha256",
    "preparations",
    "modelConfigurations",
    "contentSha256"
  ],
  "properties": {
    "schema": {
      "const": "review-craft.eval-real-repository-isolation-preparation.v1"
    },
    "adapterConfigSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preparations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "receipt"],
        "properties": {
          "adapterId": {"type": "string", "minLength": 1},
          "receipt": {"$ref": "eval-isolation-preparation.schema.json"}
        }
      }
    },
    "modelConfigurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "eval-real-repository-campaign-plan.schema.json#/$defs/modelConfiguration"
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
