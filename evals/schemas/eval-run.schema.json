{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-run.schema.json",
  "title": "Review Craft evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "status",
    "startedAt",
    "completedAt",
    "treatment",
    "source",
    "suite",
    "skill",
    "promptTemplate",
    "adapter",
    "caseTimeoutSeconds",
    "cases",
    "metrics",
    "goldenEligible",
    "contentSha256"
  ],
  "properties": {
    "schema": {
      "const": "review-craft.eval-run.v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^rce-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"
    },
    "status": {
      "enum": ["COMPLETED", "PARTIAL", "FAILED", "UNAVAILABLE"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "treatment": {
      "enum": ["REVIEW_CRAFT", "ORDINARY_PROMPT", "CODEX_NATIVE_REVIEW"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty",
        "dirtyFingerprint",
        "treeSha256",
        "runnerSha256",
        "completedRevision",
        "completedDirty",
        "completedDirtyFingerprint",
        "completedTreeSha256",
        "stableThroughoutRun"
      ],
      "properties": {
        "revision": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": "boolean"
        },
        "dirtyFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "completedRevision": {
          "type": ["string", "null"]
        },
        "completedDirty": {
          "type": "boolean"
        },
        "completedDirtyFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "completedTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "stableThroughoutRun": {
          "type": "boolean"
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "selectedCaseIds", "fullSuite"],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selectedCaseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fullSuite": {
          "type": "boolean"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "treeSha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "promptTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "command"],
      "properties": {
        "description": {
          "$ref": "eval-adapter.schema.json"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "caseTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "fixtureArtifact",
          "fixtureTreeSha256",
          "promptArtifact",
          "promptSha256",
          "status",
          "durationMs",
          "exitCode",
          "stdoutArtifact",
          "stdoutSha256",
          "stderrArtifact",
          "stderrSha256",
          "adapterOutputArtifact",
          "adapterOutputSha256",
          "normalizedOutputArtifact",
          "normalizedOutputSha256",
          "failureReason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "enum": ["positive", "negative"]
          },
          "fixtureArtifact": {
            "$ref": "#/$defs/artifact"
          },
          "fixtureTreeSha256": {
            "$ref": "#/$defs/sha256"
          },
          "promptArtifact": {
            "$ref": "#/$defs/artifact"
          },
          "promptSha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "enum": ["COMPLETED", "FAILED", "UNAVAILABLE"]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "stdoutArtifact": {
            "$ref": "#/$defs/artifact"
          },
          "stdoutSha256": {
            "$ref": "#/$defs/sha256"
          },
          "stderrArtifact": {
            "$ref": "#/$defs/artifact"
          },
          "stderrSha256": {
            "$ref": "#/$defs/sha256"
          },
          "adapterOutputArtifact": {
            "anyOf": [
              {"$ref": "#/$defs/artifact"},
              {"type": "null"}
            ]
          },
          "adapterOutputSha256": {
            "anyOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          },
          "normalizedOutputArtifact": {
            "anyOf": [
              {"$ref": "#/$defs/artifact"},
              {"type": "null"}
            ]
          },
          "normalizedOutputSha256": {
            "anyOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          },
          "failureReason": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCases",
        "completedCases",
        "failedCases",
        "unavailableCases",
        "totalDurationMs",
        "executionCoveragePercent",
        "candidateRecallPercent",
        "findingPrecisionPercent",
        "falsePositiveRatePercent",
        "locationAccuracyPercent",
        "evidencePresencePercent",
        "decisionAccuracyPercent",
        "rewriteRestraintPercent",
        "semanticEvidenceValidation"
      ],
      "properties": {
        "totalCases": {"type": "integer", "minimum": 1},
        "completedCases": {"type": "integer", "minimum": 0},
        "failedCases": {"type": "integer", "minimum": 0},
        "unavailableCases": {"type": "integer", "minimum": 0},
        "totalDurationMs": {"type": "integer", "minimum": 0},
        "executionCoveragePercent": {"$ref": "#/$defs/percentage"},
        "candidateRecallPercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "findingPrecisionPercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "falsePositiveRatePercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "locationAccuracyPercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "evidencePresencePercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "decisionAccuracyPercent": {"$ref": "#/$defs/percentage"},
        "rewriteRestraintPercent": {
          "anyOf": [
            {"$ref": "#/$defs/percentage"},
            {"type": "null"}
          ]
        },
        "semanticEvidenceValidation": {
          "const": "NOT_AUTOMATED"
        }
      }
    },
    "goldenEligible": {
      "type": "boolean"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
