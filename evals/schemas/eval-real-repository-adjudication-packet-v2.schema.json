{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-adjudication-packet-v2.schema.json",
  "title": "Component-rubric blinded real-repository adjudication packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignContentSha256", "adjudicatorId", "rubricVersion", "instructions", "items", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-adjudication-packet.v2"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudicatorId": {"type": "string", "minLength": 1},
    "rubricVersion": {"const": "review-craft.real-repository-component-rubric.v1"},
    "instructions": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "repository", "subjectType", "subjectContentSha256", "componentKeys", "publicPrompt", "response"],
        "properties": {
          "itemId": {"type": "string", "pattern": "^item-[0-9a-f]{20}$"},
          "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "remote", "revision", "scope"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "remote": {"type": "string", "format": "uri"},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "subjectType": {"enum": ["PROBE_RESPONSE", "ADDITIONAL_FINDING"]},
          "subjectContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "componentKeys": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {"enum": ["disposition", "actionability", "decision", "severity", "evidence", "rationale"]}
          },
          "publicPrompt": {"type": ["string", "null"], "minLength": 1},
          "response": {"type": "object"}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
