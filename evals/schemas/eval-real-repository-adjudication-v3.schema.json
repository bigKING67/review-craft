{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-adjudication-v3.schema.json",
  "title": "Component-rubric independent adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignContentSha256", "mappingContentSha256", "rubricVersion", "adjudicators", "labels", "subjectResolutions", "contentSha256"],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-adjudication.v3"},
    "campaignContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mappingContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubricVersion": {"const": "review-craft.real-repository-component-rubric.v1"},
    "adjudicators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "independent", "packetContentSha256", "submissionContentSha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["HUMAN", "AGENT_ASSISTED"]},
          "independent": {"const": true},
          "packetContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "submissionContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adjudicatorId", "itemId", "sampleId", "subjectType", "subjectKey", "subjectContentSha256", "label", "rationale", "components"],
        "properties": {
          "adjudicatorId": {"type": "string", "minLength": 1},
          "itemId": {"type": "string", "pattern": "^item-[0-9a-f]{20}$"},
          "sampleId": {"type": "string", "minLength": 1},
          "subjectType": {"enum": ["PROBE_RESPONSE", "ADDITIONAL_FINDING"]},
          "subjectKey": {"type": "string", "minLength": 1},
          "subjectContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "label": {"enum": ["CORRECT", "INCORRECT", "UNRESOLVED"]},
          "rationale": {"type": "string", "minLength": 1},
          "components": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "rationale"],
              "properties": {
                "key": {"enum": ["disposition", "actionability", "decision", "severity", "evidence", "rationale"]},
                "label": {"enum": ["CORRECT", "INCORRECT", "UNRESOLVED"]},
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "subjectResolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sampleId", "subjectType", "subjectKey", "status", "resolvedLabel"],
        "properties": {
          "sampleId": {"type": "string", "minLength": 1},
          "subjectType": {"enum": ["PROBE_RESPONSE", "ADDITIONAL_FINDING"]},
          "subjectKey": {"type": "string", "minLength": 1},
          "status": {"enum": ["UNANIMOUS", "SPLIT", "ALL_UNRESOLVED"]},
          "resolvedLabel": {"type": ["string", "null"], "enum": ["CORRECT", "INCORRECT", "UNRESOLVED", null]}
        }
      }
    },
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
