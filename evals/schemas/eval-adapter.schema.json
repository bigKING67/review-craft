{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-adapter.schema.json",
  "title": "Review Craft evaluation adapter description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "model",
    "reasoning",
    "adapterVersion",
    "evidenceKind",
    "provider",
    "isolation"
  ],
  "properties": {
    "schema": {
      "enum": [
        "review-craft.eval-adapter.v2",
        "review-craft.eval-adapter.v3"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidenceKind": {
      "enum": ["REAL_HOST", "SYNTHETIC_CONTRACT"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseUrl",
        "wireApi",
        "requiresOpenAIAuth",
        "supportsWebsockets"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "baseUrl": {"type": ["string", "null"]},
        "wireApi": {"enum": ["responses", "chat"]},
        "requiresOpenAIAuth": {"type": "boolean"},
        "supportsWebsockets": {"type": "boolean"}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ignoreUserConfig",
        "ignoreRules",
        "allowCodexHomeExtensions",
        "codexHomeSystemFileCount",
        "codexHomeSystemTreeSha256",
        "codexHomeExtensionFileCount",
        "codexHomeExtensionTreeSha256"
      ],
      "properties": {
        "ignoreUserConfig": {"const": true},
        "ignoreRules": {"const": true},
        "allowCodexHomeExtensions": {"type": "boolean"},
        "codexHomeSystemFileCount": {"type": "integer", "minimum": 0},
        "codexHomeSystemTreeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "codexHomeExtensionFileCount": {"type": "integer", "minimum": 0},
        "codexHomeExtensionTreeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "transport", "environmentVariable"],
      "properties": {
        "protocol": {
          "const": "review-craft.eval-usage.v1"
        },
        "transport": {
          "const": "ENV_PATH"
        },
        "environmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_USAGE_OUTPUT"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {"const": "review-craft.eval-adapter.v3"}
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["usage"]
      }
    }
  ]
}
