{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-adapter.schema.json",
  "title": "Review Craft evaluation adapter description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "model",
    "reasoning",
    "adapterVersion",
    "evidenceKind"
  ],
  "properties": {
    "schema": {
      "const": "review-craft.eval-adapter.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidenceKind": {
      "enum": ["REAL_HOST", "SYNTHETIC_CONTRACT"]
    }
  }
}
