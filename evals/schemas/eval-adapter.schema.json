{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-adapter.schema.json",
  "title": "Review Craft evaluation adapter description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "model",
    "reasoning",
    "adapterVersion",
    "evidenceKind",
    "provider",
    "isolation"
  ],
  "properties": {
    "schema": {
      "enum": [
        "review-craft.eval-adapter.v2",
        "review-craft.eval-adapter.v3",
        "review-craft.eval-adapter.v4",
        "review-craft.eval-adapter.v5",
        "review-craft.eval-adapter.v6",
        "review-craft.eval-adapter.v7",
        "review-craft.eval-adapter.v8",
        "review-craft.eval-adapter.v9",
        "review-craft.eval-adapter.v10"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidenceKind": {
      "enum": ["REAL_HOST", "SYNTHETIC_CONTRACT"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseUrl",
        "wireApi",
        "requiresOpenAIAuth",
        "supportsWebsockets"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "baseUrl": {"type": ["string", "null"]},
        "wireApi": {"enum": ["responses", "chat"]},
        "requiresOpenAIAuth": {"type": "boolean"},
        "supportsWebsockets": {"type": "boolean"},
        "requestMaxRetries": {"type": "integer", "minimum": 0},
        "streamMaxRetries": {"type": "integer", "minimum": 0},
        "streamIdleTimeoutMs": {"type": "integer", "minimum": 1},
        "websocketConnectTimeoutMs": {"type": "integer", "minimum": 1}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ignoreUserConfig",
        "ignoreRules",
        "allowCodexHomeExtensions",
        "codexHomeSystemFileCount",
        "codexHomeSystemTreeSha256",
        "codexHomeExtensionFileCount",
        "codexHomeExtensionTreeSha256"
      ],
      "properties": {
        "homeMatchesCodexHome": {"type": "boolean", "const": true},
        "ignoreUserConfig": {"const": true},
        "ignoreRules": {"const": true},
        "allowCodexHomeExtensions": {"type": "boolean"},
        "codexHomeSystemFileCount": {"type": "integer", "minimum": 0},
        "codexHomeSystemTreeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "codexHomeExtensionFileCount": {"type": "integer", "minimum": 0},
        "codexHomeExtensionTreeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "transport", "environmentVariable"],
      "properties": {
        "protocol": {
          "const": "review-craft.eval-usage.v1"
        },
        "transport": {
          "const": "ENV_PATH"
        },
        "environmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_USAGE_OUTPUT"
        }
      }
    },
    "toolTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "transport", "environmentVariable"],
      "properties": {
        "protocol": {"const": "review-craft.eval-tool-trace.v1"},
        "transport": {"const": "ENV_PATH"},
        "environmentVariable": {"const": "REVIEW_CRAFT_EVAL_TOOL_TRACE_OUTPUT"}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "transport", "environmentVariable"],
      "properties": {
        "protocol": {"const": "review-craft.eval-progress.v1"},
        "transport": {"const": "ENV_PATH"},
        "environmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_PROGRESS_OUTPUT"
        }
      }
    },
    "isolationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "transport", "environmentVariable"],
      "properties": {
        "protocol": {"const": "review-craft.eval-isolation-receipt.v1"},
        "transport": {"const": "ENV_PATH"},
        "environmentVariable": {"const": "REVIEW_CRAFT_EVAL_ISOLATION_OUTPUT"}
      }
    },
    "timeoutControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transport",
        "environmentVariable",
        "timeoutExitCode",
        "finalizationGraceSeconds"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "review-craft.eval-timeout-control.v1",
            "review-craft.eval-timeout-control.v2"
          ]
        },
        "transport": {
          "const": "ENV_VALUE"
        },
        "environmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_SAMPLE_TIMEOUT_SECONDS"
        },
        "firstItemEnvironmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_FIRST_ITEM_TIMEOUT_SECONDS"
        },
        "timeoutExitCode": {
          "const": 124
        },
        "finalizationGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {"const": "review-craft.eval-timeout-control.v2"}
            },
            "required": ["protocol"]
          },
          "then": {"required": ["firstItemEnvironmentVariable"]},
          "else": {
            "not": {"required": ["firstItemEnvironmentVariable"]}
          }
        }
      ]
    },
    "toolBudgetControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transport",
        "repositoryLimitEnvironmentVariable",
        "skillBootstrapLimitEnvironmentVariable",
        "budgetExitCode",
        "finalizationGraceSeconds"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "review-craft.eval-tool-budget-control.v1",
            "review-craft.eval-tool-budget-control.v2",
            "review-craft.eval-tool-budget-control.v3"
          ]
        },
        "transport": {"const": "ENV_VALUE"},
        "repositoryLimitEnvironmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_REPOSITORY_TOOL_CALL_LIMIT"
        },
        "skillBootstrapLimitEnvironmentVariable": {
          "const": "REVIEW_CRAFT_EVAL_SKILL_BOOTSTRAP_TOOL_CALL_LIMIT"
        },
        "observationEvent": {"const": "item.started"},
        "semantics": {"const": "EARLY_TERMINATION_NOT_PRE_EXECUTION_BLOCK"},
        "enforcementEvent": {"const": "PreToolUse"},
        "commandEnforcement": {"const": "PRE_EXECUTION_BLOCK"},
        "nonCommandEnforcement": {"const": "ITEM_STARTED_EARLY_TERMINATION"},
        "hookDecision": {"const": "block"},
        "hookTrustMode": {"const": "AUTOMATION_BYPASS"},
        "stateTransport": {"const": "ADAPTER_MANAGED_PATH"},
        "skillBootstrapPrerequisite": {
          "const": "REQUIRED_WHEN_LIMIT_POSITIVE"
        },
        "prerequisiteEnforcement": {
          "const": "RECOVERABLE_PRE_EXECUTION_BLOCK"
        },
        "maxRecoverablePrerequisiteBlocks": {"const": 1},
        "prerequisiteFailureKind": {
          "const": "SKILL_BOOTSTRAP_REQUIRED"
        },
        "bootstrapCommandPolicy": {
          "const": "DEDICATED_BOUND_SKILL_READ_V1"
        },
        "hookConfigurationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hookImplementationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "budgetExitCode": {"const": 125},
        "finalizationGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v1"}
            },
            "required": ["protocol"]
          },
          "then": {
            "required": ["observationEvent", "semantics"],
            "not": {
              "anyOf": [
                {"required": ["enforcementEvent"]},
                {"required": ["commandEnforcement"]},
                {"required": ["nonCommandEnforcement"]},
                {"required": ["hookDecision"]},
                {"required": ["hookTrustMode"]},
                {"required": ["stateTransport"]},
                {"required": ["hookConfigurationSha256"]},
                {"required": ["hookImplementationSha256"]}
              ]
            }
          },
          "else": {
            "required": [
              "enforcementEvent",
              "commandEnforcement",
              "nonCommandEnforcement",
              "hookDecision",
              "hookTrustMode",
              "stateTransport",
              "hookConfigurationSha256",
              "hookImplementationSha256"
            ],
            "not": {
              "anyOf": [
                {"required": ["observationEvent"]},
                {"required": ["semantics"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v3"}
            },
            "required": ["protocol"]
          },
          "then": {
            "required": [
              "skillBootstrapPrerequisite",
              "prerequisiteEnforcement",
              "maxRecoverablePrerequisiteBlocks",
              "prerequisiteFailureKind",
              "bootstrapCommandPolicy"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["skillBootstrapPrerequisite"]},
                {"required": ["prerequisiteEnforcement"]},
                {"required": ["maxRecoverablePrerequisiteBlocks"]},
                {"required": ["prerequisiteFailureKind"]},
                {"required": ["bootstrapCommandPolicy"]}
              ]
            }
          }
        }
      ]
    },
    "isolationPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "invocation",
        "flag",
        "requiredWhenSystemTreeEmpty",
        "networkBoundary"
      ],
      "properties": {
        "protocol": {
          "const": "review-craft.eval-isolation-preparation.v1"
        },
        "invocation": {"const": "APPEND_FLAG"},
        "flag": {"const": "--prepare-isolation"},
        "requiredWhenSystemTreeEmpty": {"const": true},
        "networkBoundary": {"const": "OWNED_LOOPBACK_BLACKHOLE"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "reviewSandbox",
        "repairSandbox",
        "fixtureMutationBoundary"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["REVIEW", "REPAIR"]}
        },
        "reviewSandbox": {"type": "string", "const": "read-only"},
        "repairSandbox": {"type": "string", "const": "workspace-write"},
        "fixtureMutationBoundary": {
          "type": "string",
          "const": "RUNNER_STAGED_ROOT"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {"const": "review-craft.eval-adapter.v3"}
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["usage"]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {"const": "review-craft.eval-adapter.v4"}
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["usage", "toolTrace"],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {"const": "review-craft.eval-adapter.v5"}
        },
        "required": ["schema"]
      },
      "then": {
        "required": ["usage", "toolTrace", "capabilities"],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]}
        }
      }
    },
    {
      "if": {
        "properties": {"schema": {"const": "review-craft.eval-adapter.v6"}},
        "required": ["schema"]
      },
      "then": {
        "required": ["usage", "toolTrace", "progress", "isolationReceipt", "capabilities"],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]}
        }
      }
    },
    {
      "if": {
        "properties": {"schema": {"const": "review-craft.eval-adapter.v7"}},
        "required": ["schema"]
      },
      "then": {
        "required": [
          "usage",
          "toolTrace",
          "progress",
          "isolationReceipt",
          "timeoutControl",
          "toolBudgetControl",
          "capabilities"
        ],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]},
          "toolBudgetControl": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v1"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema": {"const": "review-craft.eval-adapter.v8"}},
        "required": ["schema"]
      },
      "then": {
        "required": [
          "usage",
          "toolTrace",
          "progress",
          "isolationReceipt",
          "timeoutControl",
          "toolBudgetControl",
          "capabilities"
        ],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]},
          "toolBudgetControl": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v2"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema": {"const": "review-craft.eval-adapter.v9"}},
        "required": ["schema"]
      },
      "then": {
        "required": [
          "usage",
          "toolTrace",
          "progress",
          "isolationReceipt",
          "timeoutControl",
          "toolBudgetControl",
          "capabilities"
        ],
        "properties": {
          "isolation": {"required": ["homeMatchesCodexHome"]},
          "toolBudgetControl": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v3"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema": {"const": "review-craft.eval-adapter.v10"}},
        "required": ["schema"]
      },
      "then": {
        "required": [
          "usage",
          "toolTrace",
          "progress",
          "isolationReceipt",
          "timeoutControl",
          "toolBudgetControl",
          "capabilities"
        ],
        "properties": {
          "provider": {
            "required": [
              "requestMaxRetries",
              "streamMaxRetries",
              "streamIdleTimeoutMs",
              "websocketConnectTimeoutMs"
            ]
          },
          "isolation": {"required": ["homeMatchesCodexHome"]},
          "toolBudgetControl": {
            "properties": {
              "protocol": {"const": "review-craft.eval-tool-budget-control.v3"}
            }
          }
        }
      }
    }
  ]
}
