{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-isolation-preparation.schema.json",
  "title": "Codex managed-system isolation preparation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "hostVersion",
    "startedAt",
    "completedAt",
    "before",
    "after",
    "networkBoundary",
    "processTermination",
    "durationSeconds",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-isolation-preparation.v1"},
    "status": {"enum": ["ALREADY_PREPARED", "MATERIALIZED"]},
    "hostVersion": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "before": {"$ref": "#/$defs/surface"},
    "after": {"$ref": "#/$defs/surface"},
    "networkBoundary": {
      "enum": ["NOT_USED", "OWNED_LOOPBACK_BLACKHOLE"]
    },
    "processTermination": {
      "enum": [
        "NOT_STARTED",
        "TERMINATED_AFTER_MATERIALIZATION",
        "PROCESS_EXITED_AFTER_MATERIALIZATION"
      ]
    },
    "durationSeconds": {"type": "number", "minimum": 0},
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ALREADY_PREPARED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "networkBoundary": {"const": "NOT_USED"},
          "processTermination": {"const": "NOT_STARTED"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "MATERIALIZED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "networkBoundary": {"const": "OWNED_LOOPBACK_BLACKHOLE"},
          "processTermination": {
            "enum": [
              "TERMINATED_AFTER_MATERIALIZATION",
              "PROCESS_EXITED_AFTER_MATERIALIZATION"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemFileCount",
        "systemTreeSha256",
        "userExtensionFileCount",
        "userExtensionTreeSha256"
      ],
      "properties": {
        "systemFileCount": {"type": "integer", "minimum": 0},
        "systemTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "userExtensionFileCount": {"type": "integer", "minimum": 0},
        "userExtensionTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
