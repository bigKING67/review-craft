{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-cases.schema.json",
  "title": "Review Craft evaluation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {
      "const": "review-craft.eval-cases.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "fixture",
          "seededIssue",
          "expectedDecisions",
          "prohibitedDecisions",
          "expectedLocations",
          "evidenceRequirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "class": {
            "enum": ["positive", "negative"]
          },
          "fixture": {
            "type": "string",
            "pattern": "^evals/fixtures/[a-z0-9-]+$"
          },
          "seededIssue": {
            "type": "string",
            "minLength": 1
          },
          "expectedDecisions": {
            "$ref": "#/$defs/decisions"
          },
          "prohibitedDecisions": {
            "$ref": "#/$defs/decisions"
          },
          "expectedLocations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^/].*"
            }
          },
          "evidenceRequirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "KEEP",
          "CLEAN_UP",
          "MERGE",
          "REPLACE",
          "REWRITE",
          "DELETE",
          "DEFER",
          "MEASURE",
          "DOCUMENT"
        ]
      }
    }
  }
}
