{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-routing-result.schema.json",
  "title": "Review Craft routing decision evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluationKind",
    "startedAt",
    "completedAt",
    "suite",
    "skillMetadata",
    "adapter",
    "repetitions",
    "thresholds",
    "cases",
    "metrics",
    "passed",
    "limitations",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-routing-result.v1"},
    "evaluationKind": {"const": "ROUTING_DECISION"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "suite": {"$ref": "#/$defs/binding"},
    "skillMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptionSha256", "agentsInterfaceSha256", "bindingSha256"],
      "properties": {
        "descriptionSha256": {"$ref": "#/$defs/sha256"},
        "agentsInterfaceSha256": {"$ref": "#/$defs/sha256"},
        "bindingSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "model", "reasoning", "adapterVersion", "evidenceKind"],
      "properties": {
        "schema": {"type": "string"},
        "model": {"type": "string"},
        "reasoning": {"type": "string"},
        "adapterVersion": {"type": "string"},
        "evidenceKind": {"type": "string"}
      }
    },
    "repetitions": {"type": "integer", "minimum": 2},
    "thresholds": {"$ref": "#/$defs/metrics"},
    "cases": {
      "type": "array",
      "minItems": 120,
      "items": {"$ref": "#/$defs/resultCase"}
    },
    "metrics": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repetition",
          "implicitPrecision",
          "implicitRecall",
          "explicitActivationRate",
          "workflowAccuracy",
          "highCostFalseTriggerRate",
          "passed"
        ],
        "properties": {
          "repetition": {"type": "integer", "minimum": 1},
          "implicitPrecision": {"type": "number", "minimum": 0, "maximum": 100},
          "implicitRecall": {"type": "number", "minimum": 0, "maximum": 100},
          "explicitActivationRate": {"type": "number", "minimum": 0, "maximum": 100},
          "workflowAccuracy": {"type": "number", "minimum": 0, "maximum": 100},
          "highCostFalseTriggerRate": {"type": "number", "minimum": 0, "maximum": 100},
          "passed": {"type": "boolean"}
        }
      }
    },
    "passed": {"type": "boolean"},
    "limitations": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "contentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implicitPrecision",
        "implicitRecall",
        "explicitActivationRate",
        "workflowAccuracy",
        "highCostFalseTriggerRate"
      ],
      "properties": {
        "implicitPrecision": {"type": "number", "minimum": 0, "maximum": 100},
        "implicitRecall": {"type": "number", "minimum": 0, "maximum": 100},
        "explicitActivationRate": {"type": "number", "minimum": 0, "maximum": 100},
        "workflowAccuracy": {"type": "number", "minimum": 0, "maximum": 100},
        "highCostFalseTriggerRate": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "resultCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repetition",
        "invocation",
        "expectedRoute",
        "expectedWorkflow",
        "highCostNegative",
        "selectedRoute",
        "selectedWorkflow",
        "confidence",
        "rationale",
        "routeCorrect",
        "workflowCorrect",
        "highCostFalseTrigger"
      ],
      "properties": {
        "id": {"type": "string"},
        "repetition": {"type": "integer", "minimum": 1},
        "invocation": {"enum": ["implicit", "explicit"]},
        "expectedRoute": {"$ref": "#/$defs/route"},
        "expectedWorkflow": {"$ref": "#/$defs/workflow"},
        "highCostNegative": {"type": "boolean"},
        "selectedRoute": {"$ref": "#/$defs/route"},
        "selectedWorkflow": {"$ref": "#/$defs/workflow"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"},
        "routeCorrect": {"type": "boolean"},
        "workflowCorrect": {"type": "boolean"},
        "highCostFalseTrigger": {"type": "boolean"}
      }
    },
    "route": {
      "enum": [
        "REVIEW_CRAFT",
        "NATIVE_REVIEW",
        "DESIGN_CRAFT",
        "CODEX_SECURITY",
        "DIRECT_TASK"
      ]
    },
    "workflow": {
      "enum": ["BOUNDED", "REVIEW", "DIFF", "FOCUS", "REMEDIATION", "DELIVERY", "NONE"]
    }
  }
}
