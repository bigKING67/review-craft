{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-progress.schema.json",
  "title": "Evaluation adapter lifecycle progress receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "availability",
    "startedAt",
    "threadStartedAt",
    "turnStartedAt",
    "firstItemAt",
    "lastEventAt",
    "lastEventType",
    "eventCount",
    "itemEventCount",
    "timeToFirstItemSeconds",
    "terminationReason",
    "processTreeCleanup",
    "unavailableReason"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-progress.v1"},
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "threadStartedAt": {"type": ["string", "null"], "format": "date-time"},
    "turnStartedAt": {"type": ["string", "null"], "format": "date-time"},
    "firstItemAt": {"type": ["string", "null"], "format": "date-time"},
    "lastEventAt": {"type": ["string", "null"], "format": "date-time"},
    "lastEventType": {"type": ["string", "null"], "minLength": 1},
    "eventCount": {"type": "integer", "minimum": 0},
    "itemEventCount": {"type": "integer", "minimum": 0},
    "timeToFirstItemSeconds": {"type": ["number", "null"], "minimum": 0},
    "timeToThreadStartedSeconds": {"type": ["number", "null"], "minimum": 0},
    "timeToTurnStartedSeconds": {"type": ["number", "null"], "minimum": 0},
    "firstToolCallAt": {"type": ["string", "null"], "format": "date-time"},
    "timeToFirstToolCallSeconds": {"type": ["number", "null"], "minimum": 0},
    "lastSemanticProgressAt": {"type": ["string", "null"], "format": "date-time"},
    "lastSemanticProgressType": {"type": ["string", "null"], "minLength": 1},
    "semanticProgressEventCount": {"type": "integer", "minimum": 0},
    "inactivityWarningSeconds": {"type": ["integer", "null"], "minimum": 1},
    "inactivityDiagnosticSeconds": {"type": ["integer", "null"], "minimum": 1},
    "inactivityState": {
      "enum": [
        "NOT_CONFIGURED",
        "NORMAL",
        "WARNING",
        "DIAGNOSTIC",
        "RECOVERED_WARNING",
        "RECOVERED_DIAGNOSTIC",
        "TIMED_OUT_BEFORE_FIRST_ITEM",
        "NO_ITEM_BEFORE_EXIT"
      ]
    },
    "inactivityAgeSeconds": {"type": ["number", "null"], "minimum": 0},
    "maximumPreItemInactivitySeconds": {"type": ["number", "null"], "minimum": 0},
    "diagnosticCapturedAt": {"type": ["string", "null"], "format": "date-time"},
    "processAliveWhenDiagnosticCaptured": {"type": ["boolean", "null"]},
    "providerTransportState": {
      "enum": [
        "NOT_OBSERVED",
        "WEBSOCKET_CONNECTING",
        "WEBSOCKET_CONNECTED",
        "WEBSOCKET_CONNECT_FAILED",
        "HTTPS_FALLBACK"
      ]
    },
    "providerTransportStartedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "providerTransportConnectedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "providerTransportFailedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "providerTransportFallbackAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "terminationReason": {
      "enum": [
        null,
        "PROCESS_EXIT",
        "TIMEOUT",
        "TOOL_BUDGET",
        "INTERRUPTED",
        "ERROR",
        "ADAPTER_UNAVAILABLE"
      ]
    },
    "timeoutPhase": {
      "enum": [null, "BEFORE_FIRST_ITEM", "AFTER_FIRST_ITEM"]
    },
    "toolBudgetState": {
      "enum": ["NOT_CONFIGURED", "ACTIVE", "EXCEEDED"]
    },
    "repositoryToolCallsStarted": {"type": "integer", "minimum": 0},
    "skillBootstrapToolCallsStarted": {"type": "integer", "minimum": 0},
    "repositoryToolCallsApproved": {"type": "integer", "minimum": 0},
    "skillBootstrapToolCallsApproved": {"type": "integer", "minimum": 0},
    "preExecutionCommandsBlocked": {"type": "integer", "minimum": 0},
    "skillBootstrapPrerequisiteState": {
      "enum": [
        "NOT_REQUIRED",
        "REQUIRED",
        "RECOVERY_USED",
        "SATISFIED",
        "FAILED"
      ]
    },
    "skillBootstrapPrerequisiteBlocks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "skillBootstrapPrerequisiteBlockedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "skillBootstrapPrerequisiteBlockedCommandSha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "toolBudgetExceededAt": {"type": ["string", "null"], "format": "date-time"},
    "toolBudgetExceededKind": {
      "enum": [
        null,
        "REPOSITORY_CALLS",
        "SKILL_BOOTSTRAP_CALLS",
        "SKILL_BOOTSTRAP_REQUIRED",
        "UNMETERED_TOOL",
        "CONTROL_FAILURE"
      ]
    },
    "processTreeCleanup": {
      "enum": [
        "NOT_REQUIRED",
        "CONFIRMED",
        "FAILED",
        "COMPLETED",
        "NOT_VERIFIED"
      ]
    },
    "unavailableReason": {
      "enum": [
        null,
        "HOST_OUTPUT_EMPTY",
        "HOST_OUTPUT_INVALID",
        "ADAPTER_DID_NOT_REPORT_PROGRESS",
        "ADAPTER_PROGRESS_INVALID"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"availability": {"const": "AVAILABLE"}},
        "required": ["availability"]
      },
      "then": {
        "properties": {"unavailableReason": {"type": "null"}}
      },
      "else": {
        "properties": {"unavailableReason": {"type": "string"}}
      }
    }
  ]
}
