{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-ablation-snapshot-v2.schema.json",
  "title": "Sanitized three-arm ablation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "suite",
    "skill",
    "host",
    "ablation",
    "comparison",
    "arms",
    "deltas",
    "limitations",
    "contentSha256"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-ablation-snapshot.v2"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "treeSha256",
        "runnerSha256",
        "dirty",
        "stableThroughoutRun"
      ],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "runnerSha256": {"$ref": "#/$defs/sha256"},
        "dirty": {"type": "boolean", "const": false},
        "stableThroughoutRun": {"type": "boolean", "const": true}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "selectedCaseIds", "fullSuite"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "selectedCaseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "fullSuite": {"type": "boolean", "const": true}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "treeSha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "treeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model",
        "reasoning",
        "adapterVersion",
        "evidenceKind",
        "provider",
        "isolation"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "evidenceKind": {"type": "string", "const": "REAL_HOST"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "wireApi",
            "requiresOpenAIAuth",
            "supportsWebsockets"
          ],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
            "wireApi": {"type": "string", "enum": ["responses", "chat"]},
            "requiresOpenAIAuth": {"type": "boolean"},
            "supportsWebsockets": {"type": "boolean"}
          }
        },
        "isolation": {
          "$ref": "eval-adapter.schema.json#/properties/isolation"
        }
      }
    },
    "ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256", "scheduleSha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rca-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}(?:-[0-9]+)?$"
        },
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "scheduleSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "matched",
        "comparativeEligible",
        "adjudicator"
      ],
      "properties": {
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "matched": {"type": "boolean", "const": true},
        "comparativeEligible": {"type": "boolean", "const": true},
        "adjudicator": {
          "$ref": "eval-ablation-adjudication-v2.schema.json#/$defs/adjudicator"
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "eval-ablation-comparison-v2.schema.json#/$defs/arm"}
    },
    "deltas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "eval-ablation-comparison-v2.schema.json#/$defs/delta"}
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "string",
          "const": "This snapshot reports one matched three-arm run over the bound suite; it does not establish stability across reruns, models, repositories, or environments."
        },
      {
        "type": "string",
        "const": "The percentage-point deltas are narrow observations for the bound prompts, fixtures, host, and adjudication protocol, not a general causal claim; the B-to-C delta adds both Review Craft skill instructions and verifier feedback, so it does not isolate either contribution."
      },
        {
          "type": "string",
          "const": "The fixtures are controlled evaluation cases. Adjudication withholds treatment labels and raw prompts, but outputs or tool traces may still reveal intervention characteristics; this is not guaranteed evaluator blinding."
        }
      ],
      "items": false
    },
    "contentSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
