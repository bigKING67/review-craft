{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-remediation-repair-output.schema.json",
  "title": "Normalized remediation safety repair output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome", "claimedPaths", "summary"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-remediation-repair-output.v1"
    },
    "outcome": {"type": "string", "enum": ["CHANGED", "NO_CHANGE"]},
    "claimedPaths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
