{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-ablation-adjudication-v2.schema.json",
  "title": "Treatment-blinded adjudication input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ablationId", "ablationContentSha256", "bundleContentSha256", "adjudicator", "samples"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-ablation-adjudication.v2"
    },
    "ablationId": {"type": "string", "minLength": 1},
    "ablationContentSha256": {"$ref": "#/$defs/sha256"},
    "bundleContentSha256": {"$ref": "#/$defs/sha256"},
    "adjudicator": {"$ref": "#/$defs/adjudicator"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["HUMAN", "AGENT_ASSISTED"]
        },
        "protocol": {"type": "string", "minLength": 1}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "outcome",
        "decisionDisposition",
        "evidenceDisposition",
        "falsificationDisposition",
        "externalFeedbackDisposition",
        "rationale"
      ],
      "properties": {
        "sampleId": {"type": "string", "pattern": "^sample-[a-f0-9]{16}$"},
        "outcome": {
          "type": "string",
          "enum": ["SEEDED_ISSUE_MATCH", "OTHER_VALID_FINDING", "FALSE_POSITIVE", "MISS", "NO_FINDING_CORRECT", "UNRESOLVED"]
        },
        "decisionDisposition": {
          "type": "string",
          "enum": ["APPROPRIATE", "INAPPROPRIATE", "UNRESOLVED"]
        },
        "evidenceDisposition": {
          "type": "string",
          "enum": ["DECISIVE", "SUPPORTING_ONLY", "MISALIGNED", "ABSENT", "UNRESOLVED"]
        },
        "falsificationDisposition": {
          "type": "string",
          "enum": ["ADEQUATE", "INADEQUATE", "NOT_APPLICABLE", "UNRESOLVED"]
        },
        "externalFeedbackDisposition": {
          "type": "string",
          "enum": ["DECISIVE", "NON_DECISIVE", "NOT_USED", "UNRESOLVED"]
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
