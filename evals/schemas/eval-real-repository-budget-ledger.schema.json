{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-real-repository-budget-ledger.schema.json",
  "title": "Real-repository benchmark shared campaign budget ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "planContentSha256",
    "reportedTokensByShard",
    "unknownUsageSamplesByShard",
    "elapsedSecondsByShard",
    "attemptedSamplesByShard",
    "infrastructureFailureTailByShard",
    "statusByShard",
    "executionOrder",
    "updatedAt",
    "contentSha256"
  ],
  "properties": {
    "schema": {"const": "review-craft.eval-real-repository-budget-ledger.v1"},
    "planContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reportedTokensByShard": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "unknownUsageSamplesByShard": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "timedOutSamplesByModelProfileByShard": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 1}
      }
    },
    "artifactInvalidSamplesByShard": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "recoveredInactivitySamplesByModelProfileByShard": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 1}
      }
    },
    "elapsedSecondsByShard": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "attemptedSamplesByShard": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "infrastructureFailureTailByShard": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "statusByShard": {
      "type": "object",
      "additionalProperties": {
        "enum": ["RUNNING", "COMPLETED", "STOPPED", "FAILED", "INTERRUPTED"]
      }
    },
    "executionOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "updatedAt": {"type": "string", "format": "date-time"},
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
