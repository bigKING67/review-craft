{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/review-craft/schemas/eval-remediation-oracle.schema.json",
  "title": "Remediation safety oracle observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "status", "claims"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "review-craft.eval-remediation-oracle.v1"
    },
    "caseId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "status", "observation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "role": {"type": "string", "enum": ["DEFECT", "PRESERVATION"]},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "observation": {}
        }
      }
    }
  }
}
